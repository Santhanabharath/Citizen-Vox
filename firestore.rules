rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getRole() {
      return getUserData().role;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && getRole() == 'super_admin';
    }
    
    function isMunicipalAdmin(muniId) {
      return isAuthenticated() && getRole() == 'municipal_admin' && getUserData().municipalityId == muniId;
    }
    
    function isDeptOfficer(muniId, deptId) {
      return isAuthenticated() && getRole() == 'department_officer' && getUserData().municipalityId == muniId && getUserData().departmentId == deptId;
    }

    // Users Collection
    match /users/{userId} {
      // Users can read their own profile, or admins can read all
      allow read: if isSuperAdmin() || request.auth.uid == userId;
      // Users can update their own non-role fields (enforced loosely here), admins can write all
      allow create, update: if isSuperAdmin() || request.auth.uid == userId;
      allow delete: if isSuperAdmin();
    }
    
    // Municipalities Collection
    match /municipalities/{muniId} {
      allow read: if isAuthenticated(); // Needed for dropdowns
      allow write: if isSuperAdmin();
    }
    
    // Departments Collection
    match /departments/{deptId} {
      allow read: if isAuthenticated(); 
      allow write: if isSuperAdmin() || isMunicipalAdmin(resource.data.municipalityId);
    }
    
    // Issues Collection
    match /issues/{issueId} {
      // Public reading for the map and citizen views
      allow read: if true; 
      
      // Creating: citizens can create, setting themselves as reporter
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      
      // Updating: 
      // - Super Admin can update any
      // - Municipal Admin can update if issue belongs to their municipality
      // - Dept Officer can update if issue belongs to their department
      // - Reporter can update (e.g. resolve/delete their own)
      allow update: if isSuperAdmin() || 
                    isMunicipalAdmin(resource.data.municipalityId) ||
                    isDeptOfficer(resource.data.municipalityId, resource.data.departmentId) ||
                    request.auth.uid == resource.data.reporterId;
                    
      allow delete: if isSuperAdmin() || request.auth.uid == resource.data.reporterId;
    }
    
    // Tasks Collection (Field Worker Tasks)
    match /tasks/{taskId} {
      allow read: if isSuperAdmin() ||
                  isMunicipalAdmin(resource.data.municipalityId) ||
                  isDeptOfficer(resource.data.municipalityId, resource.data.departmentId) ||
                  (isAuthenticated() && resource.data.workerId == request.auth.uid); // Worker reads own tasks
                  
      // Dept Officers and above can create/assign
      allow create: if isSuperAdmin() || 
                    isMunicipalAdmin(request.resource.data.municipalityId) ||
                    isDeptOfficer(request.resource.data.municipalityId, request.resource.data.departmentId);
                    
      // Updates: Officers can update, Worker can update their assigned tasks (to submit progress)
      allow update: if isSuperAdmin() || 
                    isMunicipalAdmin(resource.data.municipalityId) ||
                    isDeptOfficer(resource.data.municipalityId, resource.data.departmentId) ||
                    (isAuthenticated() && resource.data.workerId == request.auth.uid);
                    
      allow delete: if isSuperAdmin() || isMunicipalAdmin(resource.data.municipalityId) || isDeptOfficer(resource.data.municipalityId, resource.data.departmentId);
    }
    
    // Integrity Reports (Sensitive)
    match /integrity_reports/{reportId} {
      allow read: if isSuperAdmin() || isMunicipalAdmin(resource.data.municipalityId);
      allow create: if isAuthenticated(); // Anyone can report
      allow update, delete: if isSuperAdmin() || isMunicipalAdmin(resource.data.municipalityId);
    }
    
    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated(); // System generated creates
      allow update, delete: if false; // Immutable
    }
  }
}
